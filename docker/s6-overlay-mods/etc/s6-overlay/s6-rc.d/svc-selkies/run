#!/usr/bin/with-contenv bash

export XCURSOR_THEME=breeze
export XDG_RUNTIME_DIR=/run/user/1000
export PULSE_RUNTIME_PATH=/run/user/1000/pulse

if [ ! -f '/dev/shm/audio.lock' ]; then
  WAIT_COUNT=0
  MAX_WAIT=60
  until [ $WAIT_COUNT -ge $MAX_WAIT ] || s6-setuidgid abc pactl list sinks >/dev/null 2>&1; do
    sleep 0.5
    WAIT_COUNT=$((WAIT_COUNT + 1))
  done

  if s6-setuidgid abc pactl list sinks >/dev/null 2>&1; then
    s6-setuidgid abc pactl \
      load-module module-null-sink \
      sink_name="output" \
      sink_properties=device.description="output" 2>/dev/null || true
    s6-setuidgid abc pactl \
      load-module module-null-sink \
      sink_name="input" \
      sink_properties=device.description="input" 2>/dev/null || true
  fi
  touch /dev/shm/audio.lock
fi

if [ ! -z ${DEV_MODE+x} ]; then
  apt-get update
  apt-get install -y \
    nodejs
  npm install -g nodemon
  rm -Rf $HOME/.npm
  if [[ "${DEV_MODE}" == "core" ]]; then
    cd $HOME/src/addons/gst-web-core
    s6-setuidgid abc npm install
    s6-setuidgid abc npm run serve &
  else
    cd $HOME/src/addons/gst-web-core
    s6-setuidgid abc npm install
    s6-setuidgid abc npm run build
    s6-setuidgid abc cp dist/selkies-core.js ../${DEV_MODE}/src/
    s6-setuidgid abc nodemon --watch selkies-core.js --exec "npm run build && cp dist/selkies-core.js ../${DEV_MODE}/src/" &
    s6-setuidgid abc cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/
    s6-setuidgid abc nodemon --watch ../universal-touch-gamepad/universalTouchGamepad.js --exec "cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/" &
    s6-setuidgid abc cp -a nginx ../${DEV_MODE}/
    cd $HOME/src/addons/${DEV_MODE}
    s6-setuidgid abc npm install
    s6-setuidgid abc npm run serve &
  fi
  cd $HOME/src/src
  s6-setuidgid abc \
    nodemon -V --ext py --exec \
      "python3" -m selkies \
      --addr="localhost" \
      --mode="websockets" \
      --debug="true"
fi

export DISPLAY=${DISPLAY:-:1}

WAIT_COUNT=0
MAX_WAIT=120
X11_READY=false
until [ $WAIT_COUNT -ge $MAX_WAIT ] || DISPLAY=:1 xset q >/dev/null 2>&1; do
  sleep 0.5
  WAIT_COUNT=$((WAIT_COUNT + 1))
done

if [ $WAIT_COUNT -lt $MAX_WAIT ]; then
  X11_READY=true
fi

# WebRTC host candidates must name an address the client can reach. Left unset, Selkies
# advertises the container's own private IP (10.0.x.x), which no client can route to, so
# ICE never completes. The operator's SELKIES_WEBRTC_PUBLIC_IP wins when set; otherwise ask
# an external service for the host's public address. Non-fatal and short-timeout: if the
# lookup fails the stream still runs (over WebSockets), just without a usable WebRTC path.
if [ -z "${SELKIES_WEBRTC_PUBLIC_IP:-}" ]; then
  DETECTED_PUBLIC_IP="$(curl -fsS -m 5 https://api.ipify.org 2>/dev/null || true)"
  case "$DETECTED_PUBLIC_IP" in
    *[!0-9a-fA-F:.]*|'') DETECTED_PUBLIC_IP='' ;;
  esac
  if [ -n "$DETECTED_PUBLIC_IP" ]; then
    export SELKIES_WEBRTC_PUBLIC_IP="$DETECTED_PUBLIC_IP"
  fi
fi

# A relay only helps if the server gathers one, and an ICE-lite agent offers host
# candidates only and never touches STUN/TURN. When a TURN relay is supplied, drop
# ICE-lite so the server allocates a relay candidate the client can actually reach.
if [ -n "${SELKIES_CLOUDFLARE_TURN_TOKEN_ID:-}" ]; then
  export SELKIES_WEBRTC_ICE_LITE=false
fi

# Transport and encoder come from SELKIES_* env (Dockerfile defaults, compose overrides).
# No --mode/--encoder flags here: CLI flags outrank env, which would silently pin the stream.
# --port must match the nginx /desk/ upstream (127.0.0.1:8082).
exec s6-setuidgid abc \
  selkies \
    --port=8082
